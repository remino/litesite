#!/usr/bin/env bash
set -euo pipefail

src="${1:-}"
dist="${2:-}"

if [[ -z "$src" || -z "$dist" ]]; then
	echo "usage: $(basename "$0") SRC_DIR DIST_DIR" >&2
	exit 1
fi

mkdir -p "$dist"

minify_html() {
	local input="$1"
	local output="$2"

	mkdir -p "$(dirname "$output")"
	npx --yes html-minifier-terser \
		--collapse-boolean-attributes \
		--collapse-whitespace \
		--remove-attribute-quotes \
		--remove-comments \
		--remove-empty-attributes \
		--remove-redundant-attributes \
		--remove-script-type-attributes \
		--remove-style-link-type-attributes \
		--remove-optional-tags \
		--remove-tag-whitespace \
		--use-short-doctype \
		--minify-css true \
		--minify-js true \
		"$input" > "$output"
}

minify_js() {
	local input="$1"
	local output="$2"

	mkdir -p "$(dirname "$output")"
	npx --yes terser "$input" \
		--compress \
		--mangle \
		--comments false \
		--output "$output"
}

minify_css() {
	local input="$1"
	local output="$2"

	mkdir -p "$(dirname "$output")"
	npx --yes clean-css-cli -o "$output" "$input"
}

copy_file() {
	local input="$1"
	local output="$2"

	mkdir -p "$(dirname "$output")"
	cp -p "$input" "$output"
}

while IFS= read -r -d '' file; do
	rel="${file#"$src"/}"
	target="$dist/$rel"

	case "$rel" in
		public/*.html)
			minify_html "$file" "$target"
			;;
		public/*.js | public/*.mjs | public/*.cjs)
			minify_js "$file" "$target"
			;;
		public/*.css)
			minify_css "$file" "$target"
			;;
		public/*)
			copy_file "$file" "$target"
			;;
		*.html)
			minify_html "$file" "$target"
			;;
		*.js | *.mjs | *.cjs)
			minify_js "$file" "$target"
			;;
		*.css)
			minify_css "$file" "$target"
			;;
		*)
			copy_file "$file" "$target"
			;;
	esac
done < <(find "$src" -type f -print0)
