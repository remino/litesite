#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
	echo "usage: $(basename "$0") file.avif [output.webm]" >&2
	exit 1
fi

input="$1"
output="${2:-${input%.*}.webm}"

[[ -f "$input" ]] || exit 0
mkdir -p "$(dirname "$output")"
ffmpeg -y -hide_banner -loglevel error -i "$input" -an -sn -c:v libvpx-vp9 -pix_fmt yuv420p -crf 34 -b:v 0 "$output"
