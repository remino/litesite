#!/usr/bin/env bash
set -euo pipefail

slug="${1:-}"
dest="${2:-}"

if [[ -z "$slug" ]]; then
  echo "usage: $(basename "$0") SITE_SLUG [DEST_DIR]" >&2
  exit 1
fi

if [[ "$slug" == *"/"* ]]; then
  echo "SITE_SLUG must not contain /" >&2
  exit 1
fi

template_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
dest="${dest:-../$slug}"

if [[ -e "$dest" ]]; then
  echo "destination already exists: $dest" >&2
  exit 1
fi

mkdir -p "$(dirname "$dest")"
rsync -a \
  --exclude '.git' \
  --exclude 'dist' \
  --exclude 'node_modules' \
  "$template_root"/ "$dest"/

while IFS= read -r -d '' path; do
  new_path="${path//mysite/$slug}"
  if [[ "$path" != "$new_path" ]]; then
    mkdir -p "$(dirname "$new_path")"
    mv "$path" "$new_path"
  fi
done < <(find "$dest" -depth -name '*mysite*' -print0)

while IFS= read -r -d '' file; do
  SITE_SLUG="$slug" perl -0pi -e 's/mysite/$ENV{SITE_SLUG}/g' "$file"
done < <(find "$dest" -type f -print0)

cat >"$dest/README.md" <<'EOF'
# __SITE_SLUG__

This site was created with LiteSite.

## Development

```bash
just serve
just build
just deploy
```

## Source

Edit site content and assets under src/.
The public site files live in src/public/.
EOF

SITE_SLUG="$slug" perl -0pi -e 's/__SITE_SLUG__/$ENV{SITE_SLUG}/g' "$dest/README.md"

git -C "$dest" init -q

echo "Created $dest"
