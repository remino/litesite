#!/usr/bin/env bash
set -euo pipefail

src="${1:-}"

if [[ -z "$src" ]]; then
	echo "usage: $(basename "$0") SRC_DIR" >&2
	exit 1
fi

site_root="$(cd "$(dirname "$src")" && pwd -P)"

npx --yes live-server "$src/public" --host=0.0.0.0 --port="${PORT:-8080}" --no-browser 2>&1 \
	| sed -u "s|$site_root/|./|g"
