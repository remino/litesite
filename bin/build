#!/usr/bin/env bash
set -euo pipefail

src="${1:-}"
dist="${2:-}"

if [[ -z "$src" || -z "$dist" ]]; then
	echo "usage: $(basename "$0") SRC_DIR DIST_DIR" >&2
	exit 1
fi

if [[ -f ".env" ]]; then
	old_brotli="${LITESITE_BUILD_BROTLI-__unset__}"
	old_gzip="${LITESITE_BUILD_GZIP-__unset__}"
	old_avif_jpeg="${LITESITE_BUILD_AVIF_JPEG-__unset__}"
	old_avif_webp="${LITESITE_BUILD_AVIF_WEBP-__unset__}"
	set -a
	# shellcheck disable=SC1091
	. ./.env
	set +a
	if [[ "$old_brotli" != __unset__ ]]; then
		export LITESITE_BUILD_BROTLI="$old_brotli"
	fi
	if [[ "$old_gzip" != __unset__ ]]; then
		export LITESITE_BUILD_GZIP="$old_gzip"
	fi
	if [[ "$old_avif_jpeg" != __unset__ ]]; then
		export LITESITE_BUILD_AVIF_JPEG="$old_avif_jpeg"
	fi
	if [[ "$old_avif_webp" != __unset__ ]]; then
		export LITESITE_BUILD_AVIF_WEBP="$old_avif_webp"
	fi
fi

env_enabled() {
	local name="$1"
	local value="${!name:-1}"

	case "${value,,}" in
		0 | false | no | off | "")
			return 1
			;;
		*)
			return 0
			;;
	esac
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

rm -rf "$dist"
"$script_dir/minify-site" "$src" "$dist"
if env_enabled LITESITE_BUILD_AVIF_JPEG; then
	"$script_dir/build-media" "$dist" jpg
fi
if env_enabled LITESITE_BUILD_AVIF_WEBP; then
	"$script_dir/build-media" "$dist" webp
fi
if env_enabled LITESITE_BUILD_BROTLI; then
	"$script_dir/build-brotli" "$dist"
fi
if env_enabled LITESITE_BUILD_GZIP; then
	"$script_dir/build-gzip" "$dist"
fi
