#!/usr/bin/env bash
set -euo pipefail

root="${1:-}"

if [[ -z "$root" ]]; then
  echo "usage: $(basename "$0") ROOT_DIR [rsdeploy args...]" >&2
  exit 1
fi

if [[ "$root" != /* ]]; then
  root="$(cd "$root" && pwd)"
fi

cd "$root"

shift || true
exec rsdeploy -s "${RSDEPLOY_SRC:-dist}" -f "${RSDEPLOY_FILTER:-.rsdeploy-exclude}" "$@"
